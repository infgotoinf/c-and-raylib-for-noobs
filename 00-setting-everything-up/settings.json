  "icon_theme": "Zed (Default)",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "theme": "Gruvbox Dark",
  "terminal": {
    "shell": {
      "with_arguments": {
        "title_override": "MSYS2 UCRT64",
        "program": "cmd.exe",
        "args": [
          "/k",
          "C:\\msys64\\msys2_shell.cmd",
          "-defterm",
          "-here",
          "-no-start",
          "-ucrt64",
          "-shell",
          "fish"
        ]
      }
    }
  }
}
